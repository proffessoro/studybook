# Production settings for deploy/docker-compose.yml. Copy to `.env` next to it.
# Generate secrets with: openssl rand -hex 32

# Where people open the app (no trailing slash). Used in email links.
PUBLIC_URL=https://studybook.example.com
# The same host name, without https:// (used by the Traefik override)
DOMAIN=studybook.example.com
INSTANCE_NAME=Studybook

# Image tag to run: `latest`, or a commit SHA to pin or roll back
STUDYBOOK_TAG=latest
# IMAGE_PREFIX=ghcr.io/proffessoro/studybook

# Required: long random strings
SESSION_SECRET=
POSTGRES_PASSWORD=

# Real SMTP is required: sign-up and recovery send codes by email.
# Hostinger mail: smtp.hostinger.com, port 465 with SMTP_SECURE=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=
SMTP_FROM=Studybook <no-reply@example.com>

# Optional: "Continue with Google". Authorized redirect URI: <PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host ports (127.0.0.1 only) for a reverse proxy on the host. Unused with the Traefik override.
WEB_PORT=3100
API_PORT=4100

# Traefik override only (docker-compose.traefik.yml)
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge
