# Local development. Matches deploy/docker-compose.dev.yml.
DATABASE_URL=postgresql://studybook:studybook@localhost:5432/studybook
REDIS_URL=redis://localhost:6379
PORT=4000

# Where people open the web app (used in email links)
PUBLIC_URL=http://localhost:3000
# Required in production: a long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=dev-only-secret-change-me

# Run the email worker inside the API process (no separate `worker` process needed)
WORKER_IN_PROCESS=true

# Mailpit catches everything in development: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Studybook <no-reply@localhost>

# Optional: "Continue with Google" (ACC-04). Leave empty to turn it off.
# Create an OAuth client of type "Web application" at https://console.cloud.google.com/apis/credentials
# and add this authorized redirect URI: <PUBLIC_URL>/api/v1/auth/google/callback
# (in development: http://localhost:3000/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
