generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Instance-wide settings (design §4.6). A single row with id = 1.
/// Secrets (SMTP, Google) stay in environment variables, never here.
model InstanceSettings {
  id                       Int      @id @default(1)
  /// null = unlimited (the self-hosted default)
  defaultStorageQuotaBytes BigInt?  @map("default_storage_quota_bytes")
  /// null = unlimited (the self-hosted default)
  defaultMemberCap         Int?     @map("default_member_cap")
  /// Max upload size per file kind, in bytes, e.g. { "video": 209715200 }
  uploadLimits             Json     @default("{}") @map("upload_limits")
  /// "all" | "images" | "off"
  mediaProcessing          String   @default("images") @map("media_processing")
  catalogueEnabled         Boolean  @default(true) @map("catalogue_enabled")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("instance_settings")
}

enum Locale {
  fr
  en

  @@map("locale")
}

enum UserStatus {
  /// Signed up, email not verified yet
  pending
  active
  suspended
  deleted

  @@map("user_status")
}

/// Design §4.1. A user becomes `active` once the email is verified (ACC-01).
model User {
  id                   String             @id @default(uuid(7)) @db.Uuid
  fullName             String             @map("full_name")
  /// Public nickname, unique ignoring case
  pseudo               String             @unique @db.Citext
  /// Unique ignoring case
  email                String             @unique @db.Citext
  emailVerifiedAt      DateTime?          @map("email_verified_at")
  /// E.164, e.g. +237677123456. Null only while a Google sign-up is unfinished
  phone                String?            @unique
  /// Always null in Phase 1 (no SMS), kept for Phase 2
  phoneVerifiedAt      DateTime?          @map("phone_verified_at")
  /// argon2id. Null for Google-only accounts
  passwordHash         String?            @map("password_hash")
  locale               Locale             @default(fr)
  isInstanceAdmin      Boolean            @default(false) @map("is_instance_admin")
  status               UserStatus         @default(pending)
  /// Consent to the privacy policy at sign-up (NFR-07)
  privacyAcceptedAt    DateTime?          @map("privacy_accepted_at")
  privacyPolicyVersion String?            @map("privacy_policy_version")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  verificationCodes    VerificationCode[]
  sessions             Session[]

  @@map("users")
}

enum VerificationChannel {
  email

  @@map("verification_channel")
}

enum VerificationPurpose {
  verify
  recover
  change

  @@map("verification_purpose")
}

/// One-time codes (email verification) and link tokens (password reset) sent to a user.
/// Stored hashed, short expiry, limited attempts.
model VerificationCode {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    VerificationChannel @default(email)
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  /// The address the code was sent to
  target     String
  expiresAt  DateTime            @map("expires_at")
  attempts   Int                 @default(0)
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@index([userId, purpose])
  /// Reset links are looked up by their token's hash
  @@index([codeHash])
  @@map("verification_codes")
}

enum SessionClient {
  web
  mobile

  @@map("session_client")
}

/// Design §4.1, §5.6. Opaque random tokens, stored hashed, revocable.
/// The web app sends the token in a cookie; the Phase 3 app will send it as a Bearer header.
model Session {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The token itself is never stored
  tokenHash  String        @unique @map("token_hash")
  client     SessionClient @default(web)
  expiresAt  DateTime      @map("expires_at")
  lastSeenAt DateTime      @default(now()) @map("last_seen_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}
