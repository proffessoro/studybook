generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Instance-wide settings (design §4.6). A single row with id = 1.
/// Secrets (SMTP, Google) stay in environment variables, never here.
model InstanceSettings {
  id                       Int      @id @default(1)
  /// null = unlimited (the self-hosted default)
  defaultStorageQuotaBytes BigInt?  @map("default_storage_quota_bytes")
  /// null = unlimited (the self-hosted default)
  defaultMemberCap         Int?     @map("default_member_cap")
  /// Max upload size per file kind, in bytes, e.g. { "video": 209715200 }
  uploadLimits             Json     @default("{}") @map("upload_limits")
  /// "all" | "images" | "off"
  mediaProcessing          String   @default("images") @map("media_processing")
  catalogueEnabled         Boolean  @default(true) @map("catalogue_enabled")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("instance_settings")
}

enum Locale {
  fr
  en

  @@map("locale")
}

enum UserStatus {
  /// Signed up, email not verified yet
  pending
  active
  suspended
  deleted

  @@map("user_status")
}

/// Design §4.1. A user becomes `active` once the email is verified (ACC-01).
model User {
  id                   String             @id @default(uuid(7)) @db.Uuid
  fullName             String             @map("full_name")
  /// Public nickname, unique ignoring case
  pseudo               String             @unique @db.Citext
  /// Unique ignoring case
  email                String             @unique @db.Citext
  emailVerifiedAt      DateTime?          @map("email_verified_at")
  /// E.164, e.g. +237677123456. Null only while a Google sign-up is unfinished
  phone                String?            @unique
  /// Always null in Phase 1 (no SMS), kept for Phase 2
  phoneVerifiedAt      DateTime?          @map("phone_verified_at")
  /// argon2id. Null for Google-only accounts
  passwordHash         String?            @map("password_hash")
  locale               Locale             @default(fr)
  isInstanceAdmin      Boolean            @default(false) @map("is_instance_admin")
  status               UserStatus         @default(pending)
  /// Consent to the privacy policy at sign-up (NFR-07)
  privacyAcceptedAt    DateTime?          @map("privacy_accepted_at")
  privacyPolicyVersion String?            @map("privacy_policy_version")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  verificationCodes    VerificationCode[]
  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  ownedGroups          Group[]
  memberships          Membership[]
  createdInvites       InviteLink[]
  joinRequests         JoinRequest[]

  @@map("users")
}

enum VerificationChannel {
  email

  @@map("verification_channel")
}

enum VerificationPurpose {
  verify
  recover
  change

  @@map("verification_purpose")
}

/// One-time codes (email verification) and link tokens (password reset) sent to a user.
/// Stored hashed, short expiry, limited attempts.
model VerificationCode {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    VerificationChannel @default(email)
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  /// The address the code was sent to
  target     String
  expiresAt  DateTime            @map("expires_at")
  attempts   Int                 @default(0)
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@index([userId, purpose])
  /// Reset links are looked up by their token's hash
  @@index([codeHash])
  @@map("verification_codes")
}

enum SessionClient {
  web
  mobile

  @@map("session_client")
}

/// Design §4.1, §5.6. Opaque random tokens, stored hashed, revocable.
/// The web app sends the token in a cookie; the Phase 3 app will send it as a Bearer header.
model Session {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The token itself is never stored
  tokenHash  String        @unique @map("token_hash")
  client     SessionClient @default(web)
  expiresAt  DateTime      @map("expires_at")
  lastSeenAt DateTime      @default(now()) @map("last_seen_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

enum OAuthProvider {
  google

  @@map("oauth_provider")
}

/// Design §4.1. Links a user to their account at an identity provider (ACC-04).
model OAuthAccount {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  /// The provider's stable id for the person (Google's `sub`), which survives email changes
  providerUserId String        @map("provider_user_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

enum GroupVisibility {
  /// Reachable only through an invite link (the default)
  private
  /// Shown in the catalogue (GRP-04)
  listed

  @@map("group_visibility")
}

enum ProgressVisibility {
  /// Members see only their own progress
  own
  /// Members see everyone's points board (TRK-04)
  all

  @@map("progress_visibility")
}

enum GroupStatus {
  active
  /// Read-only (GRP-05)
  archived

  @@map("group_status")
}

/// Design §4.2. Quota and member cap are copied from the instance defaults at creation; null = unlimited.
model Group {
  id                     String             @id @default(uuid(7)) @db.Uuid
  ownerId                String             @map("owner_id") @db.Uuid
  owner                  User               @relation(fields: [ownerId], references: [id])
  name                   String
  /// For readable catalogue URLs (GRP-04)
  slug                   String             @unique
  description            String             @default("")
  visibility             GroupVisibility    @default(private)
  inviteRequiresApproval Boolean            @default(false) @map("invite_requires_approval")
  progressVisibility     ProgressVisibility @default(own) @map("progress_visibility")
  feedEnabled            Boolean            @default(true) @map("feed_enabled")
  /// Shown as a label only; the interface follows each user's own language (GRP-02)
  languageLabel          String?            @map("language_label")
  status                 GroupStatus        @default(active)
  /// Phase 2 paid upgrades change these per group (LIM-04)
  storageQuotaBytes      BigInt?            @map("storage_quota_bytes")
  storageUsedBytes       BigInt             @default(0) @map("storage_used_bytes")
  memberCap              Int?               @map("member_cap")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  memberships            Membership[]
  inviteLinks            InviteLink[]
  joinRequests           JoinRequest[]
  categories             GroupCategory[]
  tags                   GroupTag[]

  @@index([ownerId])
  @@index([visibility, status])
  @@map("groups")
}

enum GroupRole {
  leader
  moderator
  member

  @@map("group_role")
}

enum MembershipStatus {
  active
  left
  removed
  banned

  @@map("membership_status")
}

/// Design §4.2. One row per user and group, kept after leaving so the leader keeps the history (MEM-05).
model Membership {
  id              String           @id @default(uuid(7)) @db.Uuid
  groupId         String           @map("group_id") @db.Uuid
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            GroupRole        @default(member)
  status          MembershipStatus @default(active)
  /// Tasks published before this don't apply to the member (TSK-07)
  joinedAt        DateTime         @default(now()) @map("joined_at")
  /// Unused in Phase 1: the seam for Phase 2 subscriptions (design §9)
  accessExpiresAt DateTime?        @map("access_expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([groupId, userId])
  @@index([userId, status])
  @@map("memberships")
}

/// GRP-03. One active link per group; resetting deactivates the old one.
model InviteLink {
  id          String   @id @default(uuid(7)) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Random and unguessable; the link is /join/<token>
  token       String   @unique
  active      Boolean  @default(true)
  createdById String   @map("created_by") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([groupId, active])
  @@map("invite_links")
}

enum JoinRequestSource {
  catalogue
  invite

  @@map("join_request_source")
}

enum JoinRequestStatus {
  pending
  accepted
  rejected

  @@map("join_request_status")
}

/// MEM-04. From the catalogue, or from the invite link when approval is on.
model JoinRequest {
  id        String            @id @default(uuid(7)) @db.Uuid
  groupId   String            @map("group_id") @db.Uuid
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    JoinRequestSource
  status    JoinRequestStatus @default(pending)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([groupId, status])
  @@index([userId])
  @@map("join_requests")
}

/// Interest categories for the catalogue (GRP-04), managed by the instance admin.
model Category {
  id        String          @id @default(uuid(7)) @db.Uuid
  /// Stable identifier used in URLs, e.g. "languages"
  key       String          @unique
  nameFr    String          @map("name_fr")
  nameEn    String          @map("name_en")
  sort      Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  groups    GroupCategory[]

  @@map("categories")
}

model GroupCategory {
  groupId    String   @map("group_id") @db.Uuid
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([groupId, categoryId])
  @@index([categoryId])
  @@map("group_categories")
}

/// Free tags set by the leader (GRP-04), stored lowercased.
model GroupTag {
  groupId String @map("group_id") @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tag     String

  @@id([groupId, tag])
  @@index([tag])
  @@map("group_tags")
}
